# === Database (Supabase) ===
# Paste the full Supabase connection URL (transaction pooler recommended).
# sslmode=require is appended automatically if not present in the URL.
DB_URL=postgresql://user:password@host:port/dbname
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# === HTTP reliability limits ===
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=60s
HTTP_IDLE_TIMEOUT=2m
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_MAX_HEADER_BYTES=1048576
MAX_REQUEST_BODY_BYTES=1048576

# === JWT ===
JWT_SECRET=CHANGE_ME_random_64_char_string
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=720h

# Only trust the reverse-proxy network that sets X-Forwarded-For.
TRUSTED_PROXIES=172.16.0.0/12

# === Google OAuth ===
# GOOGLE_REDIRECT_URL must match Google Console exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.your-subdomain.yourdomain.com/api/v1/auth/google/callback

# === AWS KMS (required in production by default) ===
# AWS_REGION must match the region of your KMS key ARN.
AWS_REGION=us-east-1
AWS_KMS_KEY_ID=
# Leave both credentials empty when using an EC2/ECS IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Production refuses local encryption unless this is explicitly acknowledged.
ALLOW_LOCAL_ENCRYPTION_IN_PRODUCTION=false

# === Frontend URL (for CORS + OAuth redirects) ===
# This is the origin where your frontend is deployed (e.g. Vercel).
# Backend CORS allows only this origin. After Google login, backend
# redirects to FRONTEND_URL/auth/callback with tokens.
FRONTEND_URL=https://your-frontend-domain.com

# === Razorpay (optional — leave empty to disable billing) ===
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_TEAM=

# === Team invitation email (SMTP) ===
# Required for sending invite emails to existing and new users.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Envo
INVITE_TOKEN_TTL_HOURS=168

# === Sensitive endpoint rate limits (per actor/IP) ===
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=30
SECRET_EXPORT_RATE_LIMIT_PER_MINUTE=30
PLATFORM_SYNC_RATE_LIMIT_PER_MINUTE=10
AGENT_RESOLVE_RATE_LIMIT_PER_MINUTE=60

# === Safe performance controls ===
# Authorization, tokens, grants, and plaintext secret values are never cached.
TIER_CACHE_TTL=5m
SECRET_DECRYPT_CONCURRENCY=8
AGENT_USAGE_WRITE_INTERVAL=1m

# === Backend host port ===
# The port exposed on the EC2 host. Host Nginx proxies to this.
HOST_PORT=8080
